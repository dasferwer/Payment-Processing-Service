# Локальные значения для демонстрации; замените перед публикацией окружения.
API_KEY=local-demo-api-key
POSTGRES_PASSWORD=payments-local
RABBITMQ_PASSWORD=payments-local
API_PORT=58000
POSTGRES_PORT=55432
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=55673
RETRY_BASE_SECONDS=2
# Для запуска Python вне контейнеров:
DATABASE_URL=postgresql+asyncpg://payments:payments-local@127.0.0.1:55432/payments
RABBITMQ_URL=amqp://payments:payments-local@127.0.0.1:55672/

# Точные origin локальных webhook; удалите эти исключения вне демонстрации.
ALLOWED_WEBHOOK_ORIGINS=["http://host.docker.internal:9000","http://host.docker.internal:59001"]

POSTGRES_ADMIN_PASSWORD=local-demo-admin-password
